# New Solta Site Vercel/Supabase projects; owner-selected shared Solta Works Stripe account.
# Use the matching Stripe sandbox/live credentials. Never put credentials in Git or chat.
SOLTASITE_COMMERCE_ENABLED=false
SOLTASITE_APP_ORIGIN=https://soltasite.com
SOLTASITE_STRIPE_MODE=test
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
ORDER_ACCESS_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=soltasite.com,www.soltasite.com

# Optional local/preview design route; always unavailable on Vercel production.
SOLTASITE_DESIGN_PREVIEW=false

# No KP dispatcher is enabled by this conversion.
KP_SYNC_ENABLED=false
